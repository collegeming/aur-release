# Maintainer: {{maintainer}}

pkgname=kimi-code-desktop-bin
pkgver={{pkgver}}
pkgrel={{pkgrel}}
pkgdesc='Kimi Code Desktop - GUI client for the Kimi Code agent (prebuilt binary)'
arch=('x86_64' 'aarch64')
url='https://kimi.com/code'
license=('LicenseRef-proprietary')
# The vendor's Debian Depends/Recommends, translated to Arch names. libuuid1
# maps to util-linux, which is in base, so it is left out.
depends=('gtk3' 'libnotify' 'nss' 'libxss' 'libxtst' 'libsecret'
         'at-spi2-core' 'xdg-utils')
optdepends=('libappindicator-gtk3: tray icon')
options=('!strip')

# Both packages are assembled by this repository's build workflow (see [build]
# in metadata.toml): x86_64 is the vendor payload repacked, aarch64 is the same
# payload with the official Electron arm64 runtime and a rebuilt node-pty.
# Installing needs no toolchain.
source_x86_64=("kimi-code-desktop-bin-${pkgver}-1-x86_64.pkg.tar.zst::https://github.com/collegeming/aur-release/releases/download/aur-built-latest/{{asset_x86_64}}")
sha256sums_x86_64=('{{sha256_x86_64}}')
source_aarch64=("kimi-code-desktop-bin-${pkgver}-1-aarch64.pkg.tar.zst::https://github.com/collegeming/aur-release/releases/download/aur-built-latest/{{asset_aarch64}}")
sha256sums_aarch64=('{{sha256_aarch64}}')

package() {
    local pkg
    case "${CARCH}" in
        x86_64)  pkg="kimi-code-desktop-bin-${pkgver}-1-x86_64.pkg.tar.zst" ;;
        aarch64) pkg="kimi-code-desktop-bin-${pkgver}-1-aarch64.pkg.tar.zst" ;;
    esac

    # The source is already a pacman package: unpack its payload (minus the
    # metadata files) straight into $pkgdir. Modes, including the setuid bit on
    # chrome-sandbox, are preserved from the archive.
    bsdtar -xf "${srcdir}/${pkg}" -C "${pkgdir}" \
        --exclude '.PKGINFO' --exclude '.BUILDINFO' --exclude '.MTREE'
}
