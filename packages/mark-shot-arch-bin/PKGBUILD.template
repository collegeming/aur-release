# Maintainer: {{maintainer}}

pkgname=mark-shot-arch-bin
pkgver={{pkgver}}
pkgrel={{pkgrel}}
pkgdesc='Qt 6 Wayland screenshot selection and annotation tool (built against Arch/ALARM)'
arch=('x86_64' 'aarch64')
url='https://github.com/jswysnemc/mark-shot'
license=('MIT')
# Runtime deps are baked into the package we built, so these mirror the
# generated .PKGINFO. layer-shell-qt is x86_64-only: the ALARM build disables
# the layer-shell integration (same as upstream's Ubuntu build).
depends=('qt6-base' 'qt6-svg' 'qt6-wayland' 'pipewire' 'grim' 'wl-clipboard' 'hicolor-icon-theme' 'python')
depends_x86_64=('layer-shell-qt')
provides=('mark-shot')
conflicts=('mark-shot' 'mark-shot-bin')
options=('!strip' '!debug')

# The pacman packages below are built by this repository's build-package
# workflow, which compiles upstream against Arch Linux (x86_64) and Arch Linux
# ARM (aarch64). Installing them needs no build toolchain.
#
# They are prebuilt packages, so there is nothing to compile here: unpacking the
# .pkg.tar.zst's payload into $pkgdir is the whole install.
source_x86_64=("mark-shot-arch-bin-${pkgver}-1-x86_64.pkg.tar.zst::https://github.com/collegeming/aur-built-packages/releases/download/aur-built-latest/{{asset_x86_64}}")
sha256sums_x86_64=('{{sha256_x86_64}}')
source_aarch64=("mark-shot-arch-bin-${pkgver}-1-aarch64.pkg.tar.zst::https://github.com/collegeming/aur-built-packages/releases/download/aur-built-latest/{{asset_aarch64}}")
sha256sums_aarch64=('{{sha256_aarch64}}')

package() {
    # A .pkg.tar.zst is just a zstd-compressed tarball whose first member is
    # .PKGINFO. Extract everything except that metadata file straight into
    # $pkgdir -- usr/bin, usr/share/{applications,icons,licenses,doc} land in
    # the right places.
    local pkg
    case "${CARCH}" in
        x86_64)  pkg="mark-shot-arch-bin-${pkgver}-1-x86_64.pkg.tar.zst" ;;
        aarch64) pkg="mark-shot-arch-bin-${pkgver}-1-aarch64.pkg.tar.zst" ;;
    esac

    bsdtar -xf "${srcdir}/${pkg}" -C "${pkgdir}" --exclude '.PKGINFO' --exclude '.BUILDINFO' --exclude '.MTREE'

    chmod -R u=rwX,go=rX "${pkgdir}"
}

# The package ships the full runtime dependency set in its .PKGINFO, so trust
# the file list rather than re-deriving it.
check() {
    :
}
